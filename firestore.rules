rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing production rules used by /getlink and Netflix settings.
    match /app_data/{document=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'cungbocap306@gmail.com';
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email in [
          "cungbocap306@gmail.com"
        ];
    }

    match /data_pages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /data_public_accounts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /data_accounts/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
