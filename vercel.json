{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/data/?$",
      "dest": "/data/admin/index.html"
    },
    {
      "src": "/data/admin/?$",
      "dest": "/data/admin/index.html"
    },
    {
      "src": "/data/[^/.]+/?$",
      "dest": "/data/index.html"
    },
    {
      "src": "/capcut/admin/?$",
      "dest": "/capcut/admin.html"
    },
    {
      "src": "/capcut(?:/[^/.]+)?/?$",
      "dest": "/capcut/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/ads/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/serve/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
